local tabs      = {}
local activeTab = nil

local tabColors = {
    Combat = Color3.fromRGB(220,80,80),
    Auto   = Color3.fromRGB(80,180,220),
    ESP    = Color3.fromRGB(80,220,120),
    Player = Color3.fromRGB(220,180,80),
    Visual = Color3.fromRGB(180,100,220),
    Event  = Color3.fromRGB(255,140,60),
    Misc   = Color3.fromRGB(150,150,160),
}
local tabNames = {"Combat","Auto","ESP","Player","Visual","Event","Misc"}

local function makeScrollFrame()
    local sf = Instance.new("ScrollingFrame", ContentArea)
    sf.Size                 = UDim2.new(1, 0, 1, 0)
    sf.BackgroundTransparency = 1
    sf.BorderSizePixel      = 0
    sf.ScrollBarThickness   = 3
    sf.ScrollBarImageColor3 = Color3.fromRGB(80,100,200)
    sf.CanvasSize           = UDim2.new(0,0,0,0)
    sf.AutomaticCanvasSize  = Enum.AutomaticSize.Y
    sf.Visible              = false
    sf.ZIndex               = 3
    sf.ClipsDescendants     = false
    local layout = Instance.new("UIListLayout", sf)
    layout.Padding    = UDim.new(0, 6)
    layout.SortOrder  = Enum.SortOrder.LayoutOrder
    local pad = Instance.new("UIPadding", sf)
    pad.PaddingTop    = UDim.new(0, 6)
    pad.PaddingBottom = UDim.new(0, 6)
    pad.PaddingLeft   = UDim.new(0, 4)
    pad.PaddingRight  = UDim.new(0, 8)
    return sf
end

local TabFrames = {}
for _, name in ipairs(tabNames) do
    TabFrames[name] = makeScrollFrame()
end

local function selectTab(name)
    if activeTab then
        TabFrames[activeTab].Visible = false
        local btn = tabs[activeTab]
        if btn then
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundTransparency = 0.85,
                TextColor3 = Color3.fromRGB(160,160,180)
            }):Play()
        end
    end
    activeTab = name
    TabFrames[name].Visible = true
    local btn = tabs[name]
    if btn then
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundTransparency = 0.1,
            TextColor3 = Color3.new(1,1,1)
        }):Play()
    end
end

for i, name in ipairs(tabNames) do
    local btn = Instance.new("TextButton", TabBar)
    btn.Size             = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = tabColors[name] or Color3.fromRGB(80,100,200)
