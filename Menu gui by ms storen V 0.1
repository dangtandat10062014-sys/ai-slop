--=================================================
-- ZOMBIE ESP SCANNER
--=================================================

local function removeZombieESP(obj)
    local highlight = zombieHighlights[obj]

    if highlight then
        highlight:Destroy()
        zombieHighlights[obj] = nil
    end
end

local function scanZombieESP()
    local camera = Workspace:FindFirstChild("Camera")
        or Workspace.CurrentCamera

    if not camera then
        return
    end

    for _, child in ipairs(camera:GetChildren()) do
        if child.Name ~= "m_Zombie" then
            continue
        end

        local orig = child:FindFirstChild("Orig")
        local zombie = orig and orig.Value
        local color

        if zombie then
            local zombieHumanoid = zombie:FindFirstChild("Zombie")

            if State.Runner
                and zombieHumanoid
                and zombieHumanoid.WalkSpeed > 20 then

                color = Color3.fromRGB(255, 0, 0)

            elseif State.Bomber and child:FindFirstChild("Barrel") then
                color = Color3.fromRGB(65, 105, 225)

            elseif State.Cuirassier and child:FindFirstChild("Sword") then
                color = Color3.fromRGB(65, 105, 225)

            elseif State.Zapper and child:FindFirstChild("Axe") then
                color = Color3.fromRGB(255, 0, 255)
            end
        end

        if color then
            local highlight = zombieHighlights[child]

            if not highlight or not highlight.Parent then
                highlight = Instance.new("Highlight")
                highlight.Name = "ESP_Highlight"
                highlight.Adornee = child
                highlight.Parent = child
                zombieHighlights[child] = highlight
            end

            highlight.FillColor = color
            highlight.OutlineColor = color
        else
            removeZombieESP(child)
        end
    end

    for obj in pairs(zombieHighlights) do
        if not obj.Parent then
            removeZombieESP(obj)
        end
    end
end

local espTimer = 0

RunService.Heartbeat:Connect(function(dt)
    espTimer += dt

    if espTimer >= 0.5 then
        espTimer = 0
        scanZombieESP()
    end
end)

