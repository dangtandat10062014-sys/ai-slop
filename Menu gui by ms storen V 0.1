-- AUTO REPAIR
local function getHammer()
    local character = Player.Character
    local hammer = character and character:FindFirstChild("Hammer")

    if not hammer then
        local backpack = Player:FindFirstChild("Backpack")
        hammer = backpack and backpack:FindFirstChild("Hammer")
    end

    return hammer
end

local function getBuildingPosition(building)
    if building:IsA("BasePart") then
        return building.Position
    end

    if building:IsA("Model") then
        local ok, pivot = pcall(function()
            return building:GetPivot()
        end)

        if ok then
            return pivot.Position
        end
    end

    local part = building:FindFirstChildWhichIsA(
        "BasePart",
        true
    )

    return part and part.Position
end

local function repairNearby()
    if not State.Repair then
        return
    end

    local character = Player.Character
    local root = character and character:FindFirstChild(
        "HumanoidRootPart"
    )

    local hammer = getHammer()
    local remote = hammer and hammer:FindFirstChild("RemoteEvent")
    local folder = Workspace:FindFirstChild("Buildings")

    if not root
        or not remote
        or not remote:IsA("RemoteEvent")
        or not folder then
        return
    end

    local checked = {}

    local function inspect(building)
        if checked[building] then
            return false
        end

        checked[building] = true

        local health = building:FindFirstChild("BuildingHealth")

        if not health or not health:IsA("NumberValue") then
            return false
        end

        local maxHealth = health:GetAttribute("MaxHealth")

        if not maxHealth or health.Value >= maxHealth then
            return false
        end

        local position = getBuildingPosition(building)

        if not position
            or (root.Position - position).Magnitude > REPAIR_RANGE then
            return false
        end

        -- Server must validate the repair request.
        remote:FireServer("Repair", building)

        return true
    end

    for _, item in ipairs(folder:GetChildren()) do
        if inspect(item) then
            return
        end

        if item:IsA("Folder") then
            for _, building in ipairs(item:GetChildren()) do
                if inspect(building) then
                    return
                end
            end
        end
    end
end

toggle("Auto Repair", function(v)
    State.Repair = v
end)

task.spawn(function()
    while gui.Parent do
        if State.Repair then
            pcall(repairNearby)
        end

        task.wait(REPAIR_INTERVAL)
    end
end)

-- AUTO PUSH
local function getPickaxeRemote()
    local character = Player.Character
    local pickaxe = character and character:FindFirstChild("Pickaxe")

    if not pickaxe then
        local backpack = Player:FindFirstChild("Backpack")
        pickaxe = backpack and backpack:FindFirstChild("Pickaxe")
    end

    local remote = pickaxe and pickaxe:FindFirstChild("RemoteEvent")

    if remote and remote:IsA("RemoteEvent") then
        return remote
    end

    return nil
end

local function getZombiePart(zombie)
    return zombie:FindFirstChild("HumanoidRootPart")
        or zombie:FindFirstChild("Torso")
        or zombie:FindFirstChild("UpperTorso")
        or zombie:FindFirstChildWhichIsA("BasePart", true)
end

local function pushZombies()
    if not State.AutoPush then
        return
    end

    local character = Player.Character
    local root = character and character:FindFirstChild(
        "HumanoidRootPart"
    )

    local zombies = Workspace:FindFirstChild("Zombies")
    local remote = getPickaxeRemote()

    if not root or not zombies or not remote then
        return
    end

    local now = os.clock()

    for _, zombie in ipairs(zombies:GetChildren()) do
        if not zombie:IsA("Model") then
            continue
        end

        local part = getZombiePart(zombie)

        if not part then
            continue
        end

        local distance = (root.Position - part.Position).Magnitude

        if distance <= PUSH_RANGE then
            local previous = lastPush[zombie] or 0

            if now - previous >= PUSH_COOLDOWN then
                lastPush[zombie] = now

                remote:FireServer("StopBraceBlock")
                remote:FireServer(
                    "FeedbackStun",
                    zombie,
                    part.Position
                )
            end
        end
    end

    for zombie, timestamp in pairs(lastPush) do
        if not zombie.Parent or now - timestamp > 10 then
            lastPush[zombie] = nil
        end
    end
end

toggle("Auto Push", function(v)
    State.AutoPush = v

    if not v then
        table.clear(lastPush)
    end
end)

task.spawn(function()
    while gui.Parent do
        if State.AutoPush then
            pcall(pushZombies)
        end

        task.wait(PUSH_INTERVAL)
    end
end)

-- AUTO PLAY MUSIC
_G.MusicianAutoPlay = false

local function HookBeatTracker()
    local BeatTracker = require(
        game.ReplicatedStorage.Modules.Gameplay.BeatTracker
    )

    if _G.BeatTrackerHooked then
        return
    end

    _G.BeatTrackerHooked = true

    local oldUpdate = BeatTracker.update

    BeatTracker.update = function(self, dt)
        local now = tick()
        local beatHappened = false

        if self.nextBeat < now then
            beatHappened = true
        end

        oldUpdate(self, dt)

        if beatHappened and _G.MusicianAutoPlay then
            task.defer(function()
                if _G.MusicianAutoPlay
                    and self.songSource
                    and self.songSource.IsPlaying then

                    self:hit()
                end
            end)
        end
    end
end

local musicHookOK, musicHookError = pcall(HookBeatTracker)

toggle("Auto Play Music", function(v)
    State.Music = v
    _G.MusicianAutoPlay = v

    if v and not musicHookOK then
        warn("BeatTracker hook failed:", musicHookError)
    end
end)

